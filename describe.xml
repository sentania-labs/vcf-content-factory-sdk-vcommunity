<?xml version="1.0" encoding="UTF-8"?>
<!--
  describe.xml — VCF Content Factory vCommunity (Tier 2 Java SDK adapter).

  Native Java SDK rewrite of vmbro/VCF-Operations-vCommunity (Onur Yuzseven,
  CC-licensed). Pure ARIA_OPS-style stitching: the only declared object kinds
  are the type=7 adapter instance and the type=1 vCommunityWorld anchor. Every
  vCommunity| property/metric is pushed onto EXISTING foreign VMWARE
  ClusterComputeResource / HostSystem / VirtualMachine resources via the Suite
  API at runtime — those foreign kinds are intentionally NOT declared here
  (they are owned by the VMWARE adapter), exactly as the compliance reference
  adapter pushes onto VMWARE HostSystem without declaring it.

  TWO credential kinds (design Credential §): the vCenter Credential (required)
  and an optional Windows Guest Credential for guest-ops. The type=7 ResourceKind
  binds both via the comma-delimited credentialKind list (describeSchema.xsd
  line 264-266).
-->
<AdapterKind xmlns="http://schemas.vmware.com/vcops/schema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             key="vcfcf_vcommunity"
             nameKey="1"
             version="1"
             xsi:schemaLocation="http://schemas.vmware.com/vcops/schema describeSchema.xsd">

  <CredentialKinds>
    <CredentialKind key="vcenter_credentials" nameKey="2">
      <CredentialField key="user" nameKey="3" type="string"
                       required="true" dispOrder="1"/>
      <CredentialField key="password" nameKey="4" type="string"
                       required="true" password="true" dispOrder="2"/>
    </CredentialKind>
    <CredentialKind key="windows_guest_credentials" nameKey="40">
      <CredentialField key="winUser" nameKey="41" type="string"
                       required="false" dispOrder="1"/>
      <CredentialField key="winPass" nameKey="42" type="string"
                       required="false" password="true" dispOrder="2"/>
    </CredentialKind>
  </CredentialKinds>

  <ResourceKinds>

    <!-- Adapter Instance (type=7): connection + config-file names + guest enum -->
    <ResourceKind key="vcfcf_vcommunity" nameKey="5" type="7"
                  credentialKind="vcenter_credentials,windows_guest_credentials"
                  monitoringInterval="5">
      <ResourceIdentifier key="vcenter_host" nameKey="6" type="string"
                          required="true" dispOrder="1"/>
      <ResourceIdentifier key="windows_monitoring" nameKey="7" type="string"
                          required="false" dispOrder="2" default="Disabled"
                          enum="true">
        <enum value="Disabled" displayOrder="1"/>
        <enum value="Services" displayOrder="2"/>
        <enum value="Event Logs" displayOrder="3"/>
        <enum value="Services + Event Logs" displayOrder="4"/>
      </ResourceIdentifier>
      <ResourceIdentifier key="esxi_adv_settings_config_file" nameKey="8"
                          type="string" required="false" dispOrder="3"
                          default="esxi_advanced_system_settings"/>
      <ResourceIdentifier key="esxi_vib_driver_config_file" nameKey="9"
                          type="string" required="false" dispOrder="4"
                          default="esxi_packages"/>
      <ResourceIdentifier key="vm_adv_settings_config_file" nameKey="10"
                          type="string" required="false" dispOrder="5"
                          default="vm_advanced_parameters"/>
      <ResourceIdentifier key="vm_configuration_config_file" nameKey="11"
                          type="string" required="false" dispOrder="6"
                          default="vm_options"/>
      <ResourceIdentifier key="win_service_config_file" nameKey="12"
                          type="string" required="false" dispOrder="7"
                          default="windows_service_list"/>
      <ResourceIdentifier key="win_event_config_file" nameKey="13"
                          type="string" required="false" dispOrder="8"
                          default="windows_event_list"/>
      <ResourceIdentifier key="port" nameKey="14" type="string"
                          required="false" dispOrder="9" default="443"/>
      <ResourceIdentifier key="allowInsecure" nameKey="15" type="string"
                          required="false" dispOrder="10" default="false"/>
    </ResourceKind>

    <!-- vCommunityWorld: synthetic INTERNAL collection anchor (health + ops). -->
    <ResourceKind key="vCommunityWorld" nameKey="20" type="1">
      <ResourceIdentifier key="world_id" nameKey="21" type="string"
                          required="true" dispOrder="1"/>
      <ResourceGroup key="Summary" nameKey="22" instanced="false">
        <ResourceAttribute key="clusters_stitched" nameKey="23"
                           dataType="float" isProperty="false"
                           defaultMonitored="true"/>
        <ResourceAttribute key="hosts_stitched" nameKey="24"
                           dataType="float" isProperty="false"
                           defaultMonitored="true"/>
        <ResourceAttribute key="vms_stitched" nameKey="25"
                           dataType="float" isProperty="false"
                           defaultMonitored="true"/>
        <ResourceAttribute key="guest_vms_attempted" nameKey="26"
                           dataType="float" isProperty="false"
                           defaultMonitored="true"/>
        <ResourceAttribute key="guest_vms_degraded" nameKey="27"
                           dataType="float" isProperty="false"
                           defaultMonitored="true"/>
        <ResourceAttribute key="events_as_properties" nameKey="28"
                           dataType="float" isProperty="false"
                           defaultMonitored="true"/>
        <ResourceAttribute key="last_scan_timestamp" nameKey="29"
                           dataType="string" isProperty="true"/>
        <ResourceAttribute key="config_file_status" nameKey="30"
                           dataType="string" isProperty="true"/>
        <ResourceAttribute key="status" nameKey="31"
                           dataType="string" isProperty="true"/>
      </ResourceGroup>
    </ResourceKind>

  </ResourceKinds>

  <LicenseConfig enabled="false"/>

</AdapterKind>
